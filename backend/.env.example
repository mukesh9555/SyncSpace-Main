# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173
# Set in production if frontend is on a different domain
# FRONTEND_URL=https://your-app.vercel.app

# API
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncspace_lite?schema=public"

# Auth
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"
JWT_EXPIRES_IN=7d

# Trust proxy (set to 1 if behind reverse proxy like nginx/vercel)
TRUST_PROXY=0
