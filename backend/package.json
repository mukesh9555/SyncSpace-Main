{
  "name": "syncspace-lite-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:diff": "prisma migrate diff --from-migrations",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:seed": "prisma db seed",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/test-integration.mjs",
    "test:all": "vitest run --exclude '**/*.integration.test.ts' && node scripts/test-integration.mjs",
    "test:watch": "vitest",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "ws": "^8.21.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
